{%- comment -%}
  専修大学向け：お知らせ注意枠 ＋ Office 365 案内枠
  - Dawn / Shopify 2.0 テーマ準拠
  - アクセシビリティ (ARIA) 対応
  - ダークモード対応
  - レスポンシブ対応
{%- endcomment -%}

<!-- ========== 注意枠 ========== -->
<aside class="su-card su-card--warning" role="note" aria-label="重要なお知らせ">
  <span class="su-card__icon" aria-hidden="true">
    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none"
         stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>
      <line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/>
    </svg>
  </span>
  <div class="su-card__body">
    <p class="su-card__title">【注意】</p>
    <p class="su-card__text">
      ネットワーク情報学部にご入学の方は、大学よりパソコンが支給されます。
    </p>
  </div>
</aside>

<!-- ========== Office 365 案内枠 ========== -->
<section class="su-card su-card--info" role="note" aria-label="Office 365 のご案内">
  <span class="su-card__icon" aria-hidden="true">
    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none"
         stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/>
      <line x1="12" y1="17" x2="12" y2="21"/>
    </svg>
  </span>
  <div class="su-card__body">
    <p class="su-card__title">Office 365 ProPlus のご利用について</p>
    <p class="su-card__text">
      専修大学在学中は、Office 365 ProPlus を入学後に<strong>無償</strong>でご利用いただけます。
    </p>
  </div>
</section>

<!-- ========== スタイル ========== -->
<style>
  /* ---- 共通カード ---- */
  .su-card {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
    padding: 1rem 1.25rem;
    border-radius: 14px;
    border-left: 5px solid;
    margin: 16px 0 20px;
    font-size: 14px;
    line-height: 1.65;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.06),
                0 4px 12px rgba(0, 0, 0, 0.04);
    transition: box-shadow 0.2s ease, transform 0.2s ease;
  }

  .su-card:hover {
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08),
                0 6px 20px rgba(0, 0, 0, 0.06);
    transform: translateY(-1px);
  }

  /* アイコン */
  .su-card__icon {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 10px;
    margin-top: 2px;
  }

  /* タイトル */
  .su-card__title {
    margin: 0;
    font-weight: 700;
    font-size: 0.95em;
    letter-spacing: 0.02em;
  }

  /* 本文 */
  .su-card__text {
    margin: 0.3rem 0 0;
    line-height: 1.65;
  }

  .su-card__text strong {
    font-weight: 700;
  }

  /* ---- 注意 (Warning) ---- */
  .su-card--warning {
    background: #fffaf0;
    border-left-color: #f5a623;
    color: #4a3700;
  }

  .su-card--warning .su-card__icon {
    background: #f5a623;
    color: #fff;
  }

  .su-card--warning .su-card__title {
    color: #c8700a;
  }

  .su-card--warning .su-card__text strong {
    color: #c8700a;
  }

  /* ---- Office / Info (Blue) ---- */
  .su-card--info {
    background: #f0f6ff;
    border-left-color: #2f80ed;
    color: #1a2a40;
  }

  .su-card--info .su-card__icon {
    background: #2f80ed;
    color: #fff;
  }

  .su-card--info .su-card__title {
    color: #1a5ec4;
  }

  .su-card--info .su-card__text strong {
    color: #1a5ec4;
    text-decoration: underline;
    text-decoration-color: #2f80ed40;
    text-underline-offset: 2px;
  }

  /* ---- レスポンシブ (Dawn 準拠ブレークポイント) ---- */
  @media (min-width: 750px) {
    .su-card {
      font-size: 15px;
      padding: 1.1rem 1.4rem;
      gap: 0.85rem;
    }

    .su-card__icon {
      width: 44px;
      height: 44px;
    }

    .su-card__icon svg {
      width: 24px;
      height: 24px;
    }
  }

  @media (min-width: 990px) {
    .su-card {
      font-size: 16px;
      padding: 1.2rem 1.5rem;
      gap: 1rem;
    }

    .su-card__icon {
      width: 48px;
      height: 48px;
      border-radius: 12px;
    }

    .su-card__icon svg {
      width: 26px;
      height: 26px;
    }
  }

  /* ---- ダークモード ---- */
  @media (prefers-color-scheme: dark) {
    .su-card--warning {
      background: #2a2010;
      border-left-color: #f5a623;
      color: #f5e6c8;
    }

    .su-card--warning .su-card__icon {
      background: #a06d0a;
      color: #fff;
    }

    .su-card--warning .su-card__title {
      color: #f5c462;
    }

    .su-card--warning .su-card__text strong {
      color: #f5c462;
    }

    .su-card--info {
      background: #121e30;
      border-left-color: #4a9af5;
      color: #c8ddf5;
    }

    .su-card--info .su-card__icon {
      background: #1a5ec4;
      color: #fff;
    }

    .su-card--info .su-card__title {
      color: #6ab0ff;
    }

    .su-card--info .su-card__text strong {
      color: #6ab0ff;
      text-decoration-color: #4a9af540;
    }

    .su-card {
      box-shadow: 0 1px 4px rgba(0, 0, 0, 0.2),
                  0 4px 12px rgba(0, 0, 0, 0.15);
    }

    .su-card:hover {
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3),
                  0 6px 20px rgba(0, 0, 0, 0.2);
    }
  }

  /* ---- 印刷対応 ---- */
  @media print {
    .su-card {
      box-shadow: none;
      break-inside: avoid;
      border: 1px solid #999;
    }

    .su-card:hover {
      transform: none;
      box-shadow: none;
    }
  }
</style>
